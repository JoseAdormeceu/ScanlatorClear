{
  "manifest_version": 3,
  "name": "NexusToons Clean",
  "version": "1.0.0",
  "description": "Oculta publicidade e pop-ups conhecidos no NexusToons sem alterar o conteúdo principal.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://nexustoons.com/*",
    "https://www.nexustoons.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://nexustoons.com/*",
        "https://www.nexustoons.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "NexusToons Clean",
    "default_popup": "popup.html"
  }
}
